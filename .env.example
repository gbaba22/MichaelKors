# Password for the /admin link. Change this before sharing the tool.
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie. Any long random string.
# If unset, a random one is generated at boot (admins are logged out on restart).
SESSION_SECRET=

# Port the server listens on.
PORT=3000

# Path to the SQLite database file.
DATABASE_FILE=./data/assessment.db
